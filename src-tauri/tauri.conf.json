{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OwnChat",
  "version": "4.72.0",
  "identifier": "app.ownchat.desktop",
  "build": {
    "frontendDist": "host/runtime/public",
    "beforeDevCommand": "node -e \"const fs=require('fs'),cp=require('child_process');const p=fs.existsSync('src-tauri/tauri.conf.json')?'tooling/stage-host.mjs':'../tooling/stage-host.mjs';const r=cp.spawnSync(process.execPath,[p],{stdio:'inherit'});process.exit(r.status||0)\"",
    "beforeBuildCommand": "node -e \"const fs=require('fs'),cp=require('child_process');const p=fs.existsSync('src-tauri/tauri.conf.json')?'tooling/stage-host.mjs':'../tooling/stage-host.mjs';const r=cp.spawnSync(process.execPath,[p],{stdio:'inherit'});process.exit(r.status||0)\""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "OwnChat",
        "url": "index.html",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": [
      "resources/services/**/*",
      "runtime/**/*",
      "host/runtime/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Entertainment",
    "shortDescription": "Boundless AI multi-branch creation platform",
    "longDescription": "OwnChat is a boundless AI multi-branch creation platform for roleplay, writing, coding, node flows, images and voice."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MaxChen12114/OwnChat/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU1MEJBOTY4RTc2NzIwQkIKUldTN0lHZm5hS2tMVlJZbVUrS09mKzFwNnJ6L3hWcStmK2lLc1Q1VEhmSUE1S3BRbWdITDNFa3kK"
    }
  }
}