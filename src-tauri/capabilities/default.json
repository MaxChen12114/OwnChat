{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "内置页面（main / panel）的能力集。T4-B 固定 origin 后这是唯一被授权的源：页面永远从随包 public/ 加载，宿主只通过 HTTP 基址参与，所以这里给的是整个应用真正可调用的命令面（旧 remote.json 已删除，不再有远端源授权）。",
  "windows": [
    "main",
    "panel"
  ],
  "permissions": [
    "core:default",
    "allow-ping",
    "allow-open-external",
    "allow-open-panel-window",
    "allow-close-panel-window",
    "allow-get-server-url",
    "allow-set-server-url",
    "allow-host-admin-password",
    "allow-read-text-file",
    "allow-import-text-file",
    "allow-export-text-file",
    "allow-export-binary-file",
    "allow-get-storage-dir",
    "allow-set-storage-dir",
    "allow-pick-storage-dir",
    "allow-open-storage-dir",
    "allow-kv-set",
    "allow-kv-get",
    "allow-kv-list",
    "allow-kv-delete",
    "allow-db-migrate",
    "allow-db-exec",
    "allow-db-tx",
    "allow-http-request",
    "allow-http-request-stream",
    "allow-tts-get-config",
    "allow-tts-set-config",
    "allow-tts-start",
    "allow-tts-stop",
    "allow-tts-pick-dir",
    "allow-tts-list-models",
    "allow-tts-pick-file",
    "allow-tts-pick-files",
    "allow-agent-workdir-get",
    "allow-agent-workdir-pick",
    "allow-agent-workdir-set",
    "allow-local-list-dir",
    "allow-local-read-file",
    "allow-local-write-file",
    "allow-local-run-command",
    "allow-local-env-info",
    "allow-svc-list",
    "allow-svc-set-enabled",
    "allow-svc-start",
    "allow-svc-stop",
    "allow-svc-restart"
  ]
}
