# ===== Cloudflare Workers / Wrangler =====
# 本地密钥（千万别提交！里面有 API key）
.dev.vars
.dev.vars.*

# wrangler 本地缓存
.wrangler/
.mf/
wrangler.toml.bak

# ===== Node =====
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ===== 构建产物 =====
dist/
build/
.cache/

# 两份提示词注册表：源 = src/prompts/bases/ 与 src/prompts/neutrals/ 下的 .md/.txt，
# 由 tooling/scripts/gen-prompts.mjs 生成（wrangler dev/deploy 前自动跑）。
# 不提交 —— 避免与文本源并存两份事实源而漂移。
src/prompts/bases/unlocked/index.js
src/prompts/bases/locked/index.js
src/prompts/presets/index.js
src/prompts/skills/index.js

# ===== 编辑器 =====
.vscode/
.idea/
*.swp
*.swo

# ===== 系统 =====
.DS_Store
Thumbs.db
desktop.ini

# ===== 环境变量（其他常见命名）=====
.env
.env.local
.env.*.local

# ===== Tauri 签名密钥（私钥绝对不能提交！）=====
ownchat.key
*.key
*.key.pub

# 2026-11-09：向量模型（43MB 二进制）不进仓库 —— 用 tooling/scripts/fetch-model.mjs 拉到本地。
public/models/
.tmp-fetch-model/

# 2026-11-14：tests 用 tsc 把 services/*.ts 编译到仓内临时目录再求值
# （TS7 是原生二进制，没有 transpileModule；且它写不了仓外的 AppData\Local\Temp）。
# 目录由 test 自己建、自己删；这里只是防"测试半路崩了留下未跟踪物"。
.tmp-policy-emit/
.tmp-gate-emit/

# 2026-11-09：agent 跑测试时落的产物（fig.png / results.json 等），不进仓库
public/_art/
.tmp-bundle/
.tmp-*-emit/

# 2026-11-27：spike 本地服务（server/local.mjs）的运行数据 —— SQLite KV / D1 仿真，
# 与线上 Cloudflare 的 KV / D1 无任何关系，纯本机状态，绝不入库。
.local-data/

# 2026-11-28（T4-B）：Tauri 的随包宿主运行树（node src-tauri/scripts/stage-host.mjs 生成）。
# 里面是 public/ 与 server/ 的构建期快照，体积 ~36MB，绝不入库；frontendDist 指向它。
src-tauri/host/

# 2026-11-28（公开版开箱即用）：安装包随包的 Node 运行时。CI 从 setup-node 的 node.exe 复制进来，
# 由 tauri.conf.json 的 bundle.resources 打进安装包；本机源码构建不生成它（回退系统 Node）。
src-tauri/runtime/*
!src-tauri/runtime/node/
!src-tauri/runtime/node/README.md
